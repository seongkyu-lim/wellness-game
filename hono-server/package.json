{
  "name": "wellness-game-hono-server",
  "version": "0.1.0",
  "private": true,
  "description": "Wellness Game API (Hono). Spring 서버(backend/)와 같은 API 계약·스키마·JWT 형식",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx watch --env-file-if-exists=.env src/node.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/node.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.6.3",
    "bcryptjs": "3.0.3",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.150.0"
  }
}
