# 백엔드 주소 (기본: http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# 소셜 로그인 client ID — 값이 없으면 해당 로그인 버튼이 비활성화됩니다.
# iOS 앱과 "같은 provider 애플리케이션"에 웹 플랫폼을 추가로 등록해야 같은 캐릭터로 연동됩니다.
# 각 provider 콘솔에 Redirect URI로 http://localhost:5173/ 을 등록하세요.

# Kakao: developers.kakao.com > 내 애플리케이션 > 앱 키 > "REST API 키"
VITE_KAKAO_CLIENT_ID=

# Naver: developers.naver.com > 애플리케이션 > Client ID (웹 서비스 URL 등록 필요)
VITE_NAVER_CLIENT_ID=

# Google: console.cloud.google.com > OAuth 클라이언트 (웹 애플리케이션 유형)
VITE_GOOGLE_CLIENT_ID=
