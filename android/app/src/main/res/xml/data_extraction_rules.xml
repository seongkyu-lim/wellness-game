<?xml version="1.0" encoding="utf-8"?>
<!-- 토큰(Keystore 키로 암호화)은 다른 기기에서 복호화할 수 없으므로 백업·이전하지 않는다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
